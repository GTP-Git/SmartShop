private data class StatDetailRow(
    val label: String,
    val value: String,
    val detail: String = "",
    val sortValue: Double = 0.0,
    val filterType: String = "",
    val filterValue: String = "",
    val filterSecondary: String = "",
)

private enum class DetailSortColumn { LABEL, VALUE }

@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun SortableDetailTableScreen(
    navController: NavHostController,
    title: String,
    labelHeader: String,
    valueHeader: String,
    rows: List<StatDetailRow>,
    blankLabel: String = "(None)",
    emptyMessage: String = "No items recorded yet.",
    valueColor: (StatDetailRow) -> Color = { Color.Unspecified },
    defaultSort: DetailSortColumn = DetailSortColumn.VALUE,
    defaultDescending: Boolean = true,
) {
    var sortColumn by remember { mutableStateOf(defaultSort) }
    var sortDirection by remember { mutableStateOf(if (defaultDescending) SortDirection.DESC else SortDirection.ASC) }

    val sortedRows = remember(rows, sortColumn, sortDirection) {
        when (sortColumn) {
            DetailSortColumn.LABEL -> when (sortDirection) {
                SortDirection.ASC -> rows.sortedBy { it.label.lowercase() }
                SortDirection.DESC -> rows.sortedByDescending { it.label.lowercase() }
            }
            DetailSortColumn.VALUE -> when (sortDirection) {
                SortDirection.ASC -> rows.sortedBy { it.sortValue }
                SortDirection.DESC -> rows.sortedByDescending { it.sortValue }
            }
        }
    }

    fun onHeaderClick(column: DetailSortColumn) {
        if (sortColumn == column) {
            sortDirection = if (sortDirection == SortDirection.ASC) SortDirection.DESC else SortDirection.ASC
        } else {
            sortColumn = column
            sortDirection = if (column == DetailSortColumn.LABEL) SortDirection.ASC else SortDirection.DESC
        }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text(title) },
                navigationIcon = { IconButton(onClick = { navController.popBackStack() }) { Icon(Icons.Default.ArrowBack, null) } }
            )
        }
    ) { p ->
        Column(modifier = Modifier.fillMaxSize().padding(p)) {
            if (rows.isEmpty()) {
                Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                    Text(emptyMessage, color = Color.Gray, textAlign = TextAlign.Center, modifier = Modifier.padding(24.dp))
                }
            } else {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .background(MaterialTheme.colorScheme.surfaceVariant)
                        .padding(horizontal = 16.dp, vertical = 12.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Row(
                        modifier = Modifier.weight(1f).clickable { onHeaderClick(DetailSortColumn.LABEL) },
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(labelHeader, fontWeight = FontWeight.Bold, style = MaterialTheme.typography.titleSmall)
                        if (sortColumn == DetailSortColumn.LABEL) {
                            Icon(
                                if (sortDirection == SortDirection.ASC) Icons.Default.KeyboardArrowUp else Icons.Default.KeyboardArrowDown,
                                contentDescription = null,
                                modifier = Modifier.size(20.dp)
                            )
                        }
                    }
                    Row(
                        modifier = Modifier.clickable { onHeaderClick(DetailSortColumn.VALUE) },
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.End
                    ) {
                        Text(valueHeader, fontWeight = FontWeight.Bold, style = MaterialTheme.typography.titleSmall, textAlign = TextAlign.End)
                        if (sortColumn == DetailSortColumn.VALUE) {
                            Icon(
                                if (sortDirection == SortDirection.ASC) Icons.Default.KeyboardArrowUp else Icons.Default.KeyboardArrowDown,
                                contentDescription = null,
                                modifier = Modifier.size(20.dp)
                            )
                        }
                    }
                }
                HorizontalDivider()
                LazyColumn(modifier = Modifier.fillMaxSize()) {
                    items(sortedRows) { row ->
                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .clickable {
                                    if (row.filterType.isNotEmpty()) {
                                        navController.openStatEntries(row.filterType, row.filterValue, row.filterSecondary)
                                    }
                                }
                                .padding(horizontal = 16.dp, vertical = 14.dp),
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            Column(modifier = Modifier.weight(1f)) {
                                Text(row.label.ifBlank { blankLabel }, fontWeight = FontWeight.Medium)
                                if (row.detail.isNotEmpty()) {
                                    Text(row.detail, style = MaterialTheme.typography.bodySmall, color = Color.Gray)
                                }
                            }
                            Text(
                                row.value,
                                modifier = Modifier.widthIn(min = 72.dp),
                                textAlign = TextAlign.End,
                                fontWeight = FontWeight.Medium,
                                color = valueColor(row)
                            )
                        }
                        HorizontalDivider()
                    }
                }
            }
        }
    }
}

