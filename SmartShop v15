// --- HELPER FUNCTIONS ---

fun getPricePerOz(totalPrice: Double, qty: Double, unit: String): Double {
    if (qty <= 0) return 0.0
    val factor = when (unit.lowercase()) {
        "oz" -> 1.0; "lb" -> 16.0; "g" -> 0.035274; "kg" -> 35.274; "ml" -> 0.033814; "l" -> 33.814; "gal" -> 128.0; else -> 1.0
    }
    return totalPrice / (qty * factor)
}

fun calculateMedian(list: List<Double>): Double {
    if (list.isEmpty()) return 0.0
    val sorted = list.sorted()
    return if (sorted.size % 2 == 0) (sorted[sorted.size / 2 - 1] + sorted[sorted.size / 2]) / 2.0 else sorted[sorted.size / 2]
}

fun normalizeProductName(name: String): String = name.lowercase().replace(Regex("[^a-z0-9]"), "")

fun normalizeStoreKey(store: String): String = store.trim().lowercase()
fun normalizeCategoryKey(category: String): String = category.trim().lowercase()
fun normalizeNameKey(name: String): String = name.trim().lowercase()

fun canonicalLabel(values: List<String>): String =
    values.map { it.trim() }.filter { it.isNotEmpty() }
        .groupingBy { it }.eachCount()
        .maxByOrNull { it.value }?.key
        ?: values.firstOrNull()?.trim().orEmpty()

fun computeStoreCounts(entries: List<PriceEntry>): List<StoreCount> =
    entries.groupBy { normalizeStoreKey(it.store) }.map { (_, list) ->
        StoreCount(canonicalLabel(list.map { it.store }), list.size)
    }

fun computeCategoryCounts(entries: List<PriceEntry>): List<CategoryCount> =
    entries.groupBy { normalizeCategoryKey(it.category) }.map { (_, list) ->
        CategoryCount(canonicalLabel(list.map { it.category }), list.size)
    }

fun computeItemNameCounts(entries: List<PriceEntry>): List<ItemNameCount> =
    entries.groupBy { normalizeNameKey(it.name) }.map { (_, list) ->
        ItemNameCount(canonicalLabel(list.map { it.name }), list.size)
    }

