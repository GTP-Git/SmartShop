class PriceViewModel(application: Application) : AndroidViewModel(application) {
    private val db = AppDatabase.getDatabase(application)
    val searchQuery = MutableStateFlow("")
    private var generativeModel = GenerativeModel(modelName = "gemini-2.5-flash", apiKey = Secrets.GEMINI_API_KEY.trim())

    var aiResponse by mutableStateOf<String?>(null); var isAiLoading by mutableStateOf(false); var lastUsedStore by mutableStateOf("")
    val shoppingList = db.priceDao().getShoppingList()
    var chatMessages = mutableStateListOf<ChatMessage>()

    init {
        viewModelScope.launch {
            lastUsedStore = db.priceDao().getLastUsedStore()?.trim() ?: ""
            db.priceDao().getAllPricesSync().forEach { entry ->
                val cleaned = entry.copy(
                    name = entry.name.trim(),
                    store = entry.store.trim(),
                    category = entry.category.trim(),
                )
                if (cleaned != entry) db.priceDao().update(cleaned)
            }
        }
    }

    @OptIn(kotlinx.coroutines.ExperimentalCoroutinesApi::class)
    val filteredPrices = searchQuery.flatMapLatest { query ->
        if (query.trim().isEmpty()) db.priceDao().getAllPrices()
        else db.priceDao().searchPrices(query.trim())
    }

    fun setSearchQuery(query: String) { searchQuery.value = query }
    fun getHistoryForProduct(name: String, barcode: String?, category: String) = db.priceDao().getHistoryForProduct(name, barcode, category)
    fun getSuggestedNames(query: String) = db.priceDao().getSuggestedNames(query)
    fun getAllPrices() = db.priceDao().getAllPrices()
    suspend fun getEntryById(id: Int) = db.priceDao().getEntryById(id)
    suspend fun getLastEntryForName(name: String) = db.priceDao().getLastEntryForName(name)

    fun saveOrUpdatePrice(id: Int, name: String, p: String, q: String, u: String, d: Long, b: String?, store: String, category: String) {
        val cleanName = name.trim()
        val cleanStore = store.trim()
        val cleanCategory = category.trim()
        val entry = PriceEntry(id, cleanName, p.toDoubleOrNull() ?: 0.0, q.toDoubleOrNull() ?: 1.0, u, d, b, cleanStore, cleanCategory)
        lastUsedStore = cleanStore; viewModelScope.launch { if (id == 0) db.priceDao().insert(entry) else db.priceDao().update(entry) }
    }
    fun deletePrice(entry: PriceEntry) { viewModelScope.launch { db.priceDao().delete(entry) } }
    fun deleteAllPrices() { viewModelScope.launch { db.priceDao().deleteAllPrices() } }
    fun addItemToList(name: String) { viewModelScope.launch { db.priceDao().insertShoppingItem(ShoppingItem(name = name)) } }
    fun toggleShoppingItem(item: ShoppingItem) { viewModelScope.launch { db.priceDao().updateShoppingItem(item.copy(isChecked = !item.isChecked)) } }
    fun deleteShoppingItem(item: ShoppingItem) { viewModelScope.launch { db.priceDao().deleteShoppingItem(item) } }
    fun clearCheckedItems() { viewModelScope.launch { db.priceDao().clearCheckedShoppingItems() } }

    fun exportData(uri: Uri) { viewModelScope.launch(Dispatchers.IO) { try { val json = Gson().toJson(BackupData(db.priceDao().getAllPricesSync(), db.priceDao().getShoppingListSync())); getApplication<Application>().contentResolver.openOutputStream(uri)?.use { it.write(json.toByteArray()) } } catch (e: Exception) { Log.e("SmartShop", "Export failed", e) } } }
    fun importData(uri: Uri) { viewModelScope.launch(Dispatchers.IO) { try { val json = BufferedReader(InputStreamReader(getApplication<Application>().contentResolver.openInputStream(uri))).readText(); val backup = Gson().fromJson(json, BackupData::class.java); db.priceDao().insertAllPrices(backup.prices.map { it.copy(id = 0) }); db.priceDao().insertAllShopping(backup.shoppingList.map { it.copy(id = 0) }); withContext(Dispatchers.Main) { Toast.makeText(getApplication(), "Merge Complete!", Toast.LENGTH_SHORT).show() } } catch (e: Exception) { withContext(Dispatchers.Main) { Toast.makeText(getApplication(), "Import Failed", Toast.LENGTH_SHORT).show() } } } }

    suspend fun fetchProduct(barcode: String): Pair<String?, String?> {
        var n: String? = null; var s: String? = null; try { val res = RetrofitClient.upcApi.getProduct(barcode); if (!res.items.isNullOrEmpty()) { n = res.items[0].title; s = res.items[0].size ?: res.items[0].weight } } catch (e: Exception) {}
        if (n.isNullOrBlank()) { try { val res = RetrofitClient.offApi.getProduct(barcode); n = res.product?.product_name; s = res.product?.quantity } catch (e: Exception) {} }; return Pair(n, s)
    }

    fun sendChatMessage(userText: String) {
        if (userText.isBlank()) return
        chatMessages.add(ChatMessage(userText, true)); isAiLoading = true
        viewModelScope.launch {
            try {
                val history = db.priceDao().getAllPricesSync().take(40).joinToString(" | ") { "[${it.category}] ${it.name} at ${it.store}: $${String.format("%.2f", getPricePerOz(it.totalPrice, it.quantity, it.unit))}/oz on ${SimpleDateFormat("MM/dd/yy", Locale.getDefault()).format(Date(it.date))}" }
                val currentList = db.priceDao().getShoppingListSync().filter { !it.isChecked }.joinToString(", ") { it.name }
                val prompt = "User Shopping History: $history. Current Shopping List: $currentList. Context: You are SmartShop AI, a blunt, data-driven grocery assistant. Answer the user's question accurately using only their history or general grocery knowledge. Be concise. Question: $userText"
                val response = generativeModel.generateContent(prompt).text ?: "AI error."
                chatMessages.add(ChatMessage(response, false))
            } catch (e: Exception) { chatMessages.add(ChatMessage("AI Error: ${e.localizedMessage}", false)) } finally { isAiLoading = false }
        }
    }

    fun getQuickTip() {
        if (isAiLoading) return
        isAiLoading = true
        viewModelScope.launch {
            try {
                val history = db.priceDao().getAllPricesSync().take(30).joinToString(" | ") { "${it.name} (${it.category}): $${String.format("%.2f", getPricePerOz(it.totalPrice, it.quantity, it.unit))}/oz" }
                val prompt = "User History: $history. You are SmartShop AI. Provide 1 high-value, blunt, data-driven shopping tip for this user. Be brief."
                val response = generativeModel.generateContent(prompt).text ?: "No tips found."
                chatMessages.add(ChatMessage("💡 Quick Tip: $response", false))
            } catch (e: Exception) { chatMessages.add(ChatMessage("Tip Error: ${e.localizedMessage}", false)) } finally { isAiLoading = false }
        }
    }
}

