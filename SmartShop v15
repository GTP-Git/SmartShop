    )
}

fun computeAvgPricePerOzByCategory(entries: List<PriceEntry>): List<StatAvgRow> =
    entries.groupBy { normalizeCategoryKey(it.category) }.map { (_, list) ->
        val unitPrices = list.map { getPricePerOz(it.totalPrice, it.quantity, it.unit) }.filter { it > 0 }
        StatAvgRow(canonicalLabel(list.map { it.category }), if (unitPrices.isEmpty()) 0.0 else unitPrices.average(), list.size)
    }

fun computeAvgPricePerOzByStore(entries: List<PriceEntry>): List<StatAvgRow> =
    entries.groupBy { normalizeStoreKey(it.store) }.map { (_, list) ->
        val unitPrices = list.map { getPricePerOz(it.totalPrice, it.quantity, it.unit) }.filter { it > 0 }
        StatAvgRow(canonicalLabel(list.map { it.store }), if (unitPrices.isEmpty()) 0.0 else unitPrices.average(), list.size)
    }

fun computePriceChanges(entries: List<PriceEntry>): List<PriceChangeRow> =
    entries.groupBy { "${normalizeNameKey(it.name)}|${normalizeCategoryKey(it.category)}" }.values
        .filter { it.size >= 2 }
        .map { list ->
            val sorted = list.sortedBy { it.date }
            val unitPrices = list.map { getPricePerOz(it.totalPrice, it.quantity, it.unit) }.filter { it > 0 }
            val median = calculateMedian(unitPrices)
            val latest = getPricePerOz(sorted.last().totalPrice, sorted.last().quantity, sorted.last().unit)
            val pct = if (median > 0) ((latest - median) / median) * 100.0 else 0.0
            PriceChangeRow(sorted.last().name, sorted.last().category, latest, median, pct, list.size)
        }

fun computePossibleDuplicates(entries: List<PriceEntry>): List<DuplicateGroupRow> =
    entries.map { it.name }.distinct()
        .groupBy { normalizeProductName(it) }
        .filter { it.value.size > 1 }
        .map { (key, names) ->
            DuplicateGroupRow(key, names.sorted(), entries.count { normalizeProductName(it.name) == key })
        }

fun parseQuantityAndUnit(rawString: String, validUnits: List<String>): Pair<String, String>? {
    val regex = Regex("([0-9.]+)\\s*([a-zA-Z]+)")
    val matches = regex.findAll(rawString.lowercase()).toList()
    for (match in matches) {
        val candidateQ = match.groupValues[1]
        val parsedUnit = match.groupValues[2]
        val mappedUnit = when {
            parsedUnit.contains("oz") || parsedUnit.contains("ounce") || parsedUnit == "fl" -> "oz"
            parsedUnit.contains("lb") || parsedUnit.contains("pound") -> "lb"
            parsedUnit == "g" || parsedUnit.contains("gram") -> "g"
            parsedUnit == "kg" || parsedUnit.contains("kilo") -> "kg"
            parsedUnit.contains("ml") || parsedUnit.contains("milli") -> "ml"
            parsedUnit == "l" || parsedUnit == "liter" || parsedUnit == "liters" -> "l"
            parsedUnit.contains("gal") -> "gal"
            else -> parsedUnit
        }
        if (validUnits.contains(mappedUnit)) return Pair(candidateQ, mappedUnit)
    }
    return null
}

