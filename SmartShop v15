fun filterEntriesForStat(entries: List<PriceEntry>, filterType: String, filterValue: String, filterSecondary: String = ""): List<PriceEntry> =
    when (filterType) {
        "CATEGORY" -> entries.filter { normalizeCategoryKey(it.category) == normalizeCategoryKey(filterValue) }
        "STORE" -> entries.filter { normalizeStoreKey(it.store) == normalizeStoreKey(filterValue) }
        "NAME" -> entries.filter { normalizeNameKey(it.name) == normalizeNameKey(filterValue) }
        "PRODUCT" -> entries.filter { normalizeNameKey(it.name) == normalizeNameKey(filterValue) && normalizeCategoryKey(it.category) == normalizeCategoryKey(filterSecondary) }
        "DUPLICATE" -> entries.filter { normalizeProductName(it.name) == filterValue }
        else -> emptyList()
    }

fun statEntryScreenTitle(filterType: String, filterValue: String, filterSecondary: String = ""): String = when (filterType) {
    "CATEGORY" -> filterValue.ifBlank { "(Uncategorized)" }
    "STORE" -> filterValue.ifBlank { "(No store)" }
    "NAME" -> filterValue.ifBlank { "(Unnamed)" }
    "PRODUCT" -> if (filterSecondary.isNotBlank()) "$filterValue ($filterSecondary)" else filterValue
    "DUPLICATE" -> "Similar names"
    else -> "Entries"
}

private const val STAT_EMPTY_FILTER = "_empty_"

fun encodeStatFilterValue(value: String): String =
    if (value.isEmpty()) STAT_EMPTY_FILTER else Uri.encode(value)

fun decodeStatFilterValue(value: String): String =
    if (value == STAT_EMPTY_FILTER) "" else Uri.decode(value)

fun NavHostController.openStatEntries(filterType: String, filterValue: String, filterSecondary: String = "") {
    navigate(
