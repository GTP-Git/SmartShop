    filterSecondary: String,
) {
    val allPrices by vm.getAllPrices().collectAsState(initial = emptyList())
    val entries = remember(allPrices, filterType, filterValue, filterSecondary) {
        filterEntriesForStat(allPrices, filterType, filterValue, filterSecondary).sortedByDescending { it.date }
    }
    val title = statEntryScreenTitle(filterType, filterValue, filterSecondary)
    val dateFormat = remember { SimpleDateFormat("MM/dd/yy", Locale.getDefault()) }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text(title) },
                navigationIcon = { IconButton(onClick = { navController.popBackStack() }) { Icon(Icons.Default.ArrowBack, null) } }
            )
        }
    ) { p ->
        Column(modifier = Modifier.fillMaxSize().padding(p)) {
            Text(
                "${entries.size} entries",
                modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp),
                style = MaterialTheme.typography.bodySmall,
                color = Color.Gray
            )
            if (entries.isEmpty()) {
                Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                    Text("No entries found.", color = Color.Gray)
                }
            } else {
                LazyColumn(modifier = Modifier.fillMaxSize()) {
                    items(entries) { ent ->
                        val unitPrice = getPricePerOz(ent.totalPrice, ent.quantity, ent.unit)
                        ListItem(
                            headlineContent = { Text(ent.name) },
                            supportingContent = {
                                Text(
                                    "[${ent.category}] $${String.format("%.2f", ent.totalPrice)} · $${String.format("%.2f", unitPrice)}/oz · ${ent.store.ifBlank { "No store" }} · ${dateFormat.format(Date(ent.date))}"
                                )
                            },
                            modifier = Modifier.clickable { navController.navigate("entry?entryId=${ent.id}") }
                        )
                        HorizontalDivider()
                    }
                }
            }
        }
    }
}

