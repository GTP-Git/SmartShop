@Entity(tableName = "prices")
data class PriceEntry(
    @PrimaryKey(autoGenerate = true) val id: Int = 0,
    val name: String,
    val totalPrice: Double,
    val quantity: Double,
    val unit: String,
    val date: Long,
    val barcode: String? = null,
    val store: String = "",
    val category: String = "General"
)

@Entity(tableName = "shopping_list")
data class ShoppingItem(@PrimaryKey(autoGenerate = true) val id: Int = 0, val name: String, val isChecked: Boolean = false)

data class CategoryCount(val category: String, val itemCount: Int)
data class StoreCount(val store: String, val itemCount: Int)
data class ItemNameCount(val name: String, val itemCount: Int)

@Dao
interface PriceDao {
    @Insert(onConflict = OnConflictStrategy.IGNORE) suspend fun insert(entry: PriceEntry)
    @Insert(onConflict = OnConflictStrategy.IGNORE) suspend fun insertAllPrices(entries: List<PriceEntry>)
    @Insert(onConflict = OnConflictStrategy.IGNORE) suspend fun insertAllShopping(items: List<ShoppingItem>)
    @Update suspend fun update(entry: PriceEntry)
    @Delete suspend fun delete(entry: PriceEntry)
    @Query("SELECT * FROM prices ORDER BY date DESC") fun getAllPrices(): Flow<List<PriceEntry>>
    @Query("SELECT * FROM prices") suspend fun getAllPricesSync(): List<PriceEntry>
    @Query("SELECT * FROM prices WHERE id = :id LIMIT 1") suspend fun getEntryById(id: Int): PriceEntry?
    @Query("SELECT * FROM prices WHERE name LIKE '%' || :query || '%' ORDER BY date DESC") fun searchPrices(query: String): Flow<List<PriceEntry>>
    @Query("SELECT * FROM prices WHERE (LOWER(name) = LOWER(:productName) OR barcode = :barcode) AND category = :category ORDER BY date ASC")
    fun getHistoryForProduct(productName: String, barcode: String?, category: String): Flow<List<PriceEntry>>
    @Query("SELECT DISTINCT name FROM prices WHERE name LIKE '%' || :query || '%' LIMIT 5") fun getSuggestedNames(query: String): Flow<List<String>>
    @Query("SELECT * FROM prices WHERE name = :name OR barcode = :name ORDER BY date DESC LIMIT 1") suspend fun getLastEntryForName(name: String): PriceEntry?
    @Query("DELETE FROM prices") suspend fun deleteAllPrices()
    @Query("SELECT store FROM prices WHERE store != '' ORDER BY date DESC LIMIT 1") suspend fun getLastUsedStore(): String?
    @Insert(onConflict = OnConflictStrategy.IGNORE) suspend fun insertShoppingItem(item: ShoppingItem)
    @Update suspend fun updateShoppingItem(item: ShoppingItem)
    @Delete suspend fun deleteShoppingItem(item: ShoppingItem)
    @Query("SELECT * FROM shopping_list ORDER BY isChecked ASC, id DESC") fun getShoppingList(): Flow<List<ShoppingItem>>
    @Query("SELECT * FROM shopping_list") suspend fun getShoppingListSync(): List<ShoppingItem>
    @Query("DELETE FROM shopping_list WHERE isChecked = 1") suspend fun clearCheckedShoppingItems()
}

@Database(entities = [PriceEntry::class, ShoppingItem::class], version = 7) // Version 7
abstract class AppDatabase : RoomDatabase() {
    abstract fun priceDao(): PriceDao
    companion object {
        // Migration logic added here.
        // MIGRATION_6_7 is currently empty because we reverted the Brand field,
        // but it establishes the bridge so data is not lost during the version jump.
        val MIGRATION_6_7 = object : Migration(6, 7) {
            override fun migrate(db: SupportSQLiteDatabase) {
                // No SQL changes needed as we reverted the brand field,
                // but this prevents destructive migration.
            }
        }

        @Volatile var INSTANCE: AppDatabase? = null
        fun getDatabase(context: android.content.Context): AppDatabase {
            return INSTANCE ?: synchronized(this) {
                val instance = Room.databaseBuilder(context.applicationContext, AppDatabase::class.java, "shop_db")
                    .addMigrations(MIGRATION_6_7) // Migration capability enabled
                    .fallbackToDestructiveMigration() // Safety fallback
                    .build()
                INSTANCE = instance
                instance
            }
        }
    }
}

